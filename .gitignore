# Dependencies
node_modules/

# Build outputs — all dist dirs at any depth
**/dist/

# TypeScript incremental build info
*.tsbuildinfo

# Compiled artifacts that end up alongside source files
packages/**/*.js
packages/**/*.d.ts
packages/**/*.js.map
packages/**/*.d.ts.map
# But keep pipeline.py and docs-skill (they are real source)
!packages/**/pipeline.py
!packages/**/docs-skill/**

# Generated docs (runtime output, not source)
repomap-docs/
docs/

# Graphify intermediate outputs
graphify-out/
**/graphify-out/

# Repomap config knowledge cache
**/data/knowledge.json

# Repomap debug dumps (from `generate --debug`)
.repomap-debug/
**/.repomap-debug/

# Local repomap config (machine-specific paths). Use examples/repomap.config.yml
# as the canonical template. Run `repomap init` to generate yours.
/repomap.config.yml

# Environment
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/
.nyc_output/

# Caches
.eslintcache
.cache/
.tmp/
tmp/

# npm pack artifacts
*.tgz

# Local npm auth (never commit this)
.npmrc

# Claude internal
.claude/scheduled_tasks.lock
